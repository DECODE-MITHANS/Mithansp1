rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /responses/{responseId} {

      // Visitors can submit YES/NO responses
      allow create: if
        request.resource.data.keys().hasOnly([
          'username',
          'answer',
          'visitorId',
          'createdAt'
        ])
        &&
        request.resource.data.answer in ['YES', 'NO']
        &&
        (
          request.resource.data.username == null ||
          (
            request.resource.data.username is string &&
            request.resource.data.username.size() <= 30
          )
        )
        &&
        request.resource.data.visitorId is string;

      // Only authenticated users can read responses
      allow read: if request.auth != null;

      // Nobody can modify or delete responses
      allow update, delete: if false;
    }
  }
}
